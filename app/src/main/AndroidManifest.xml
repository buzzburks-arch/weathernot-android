<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- osmdroid's tile cache checks connectivity before fetching. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        usesCleartextTraffic is for local development only: it lets the app
        reach a plain-HTTP weathernot API (10.0.2.2:8000 from the emulator).
        Tighten it before a release build talks to a deployed HTTPS API.
    -->
    <application
        android:name=".WeatherNotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherNot"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WeatherNot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The links the backend puts in alerts: weathernot://event/<id>[/criterion/<id>]. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="weathernot" android:host="event" />
            </intent-filter>
        </activity>
    </application>
</manifest>

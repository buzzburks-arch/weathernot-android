# Android/Gradle
#
# gitignore contributors: remember to update Global/Android.gitignore

*.iml
.gradle/
.kotlin/
/local.properties
.idea/
.DS_Store
/build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Per-module Gradle build output
app/build/
weathernotkit/build/

# Keystores -- never commit signing credentials
*.jks
*.keystore

# Generated by `gradle wrapper` -- the jar itself IS committed (that's
# the point of the wrapper: a clean checkout can run ./gradlew with no
# other setup), only these machine-local bits are ignored.
gradle-wrapper.properties.orig
